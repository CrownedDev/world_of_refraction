{
  "permissions": {
    "allow": [
      "Bash(bash Scripts/ue/build.sh)",
      "Bash(bash Scripts/ue/test.sh:*)",
      "Bash(Scripts/ue/build.sh)",
      "Bash(Scripts/ue/test.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Edit(Content/**)",
      "Write(Content/**)",
      "Read(Intermediate/**)",
      "Read(Binaries/**)",
      "Read(Saved/**)",
      "Read(DerivedDataCache/**)",
      "Read(Content/**)",
      "Read(.vs/**)",
      "Read(Plugins/**/Intermediate/**)",
      "Read(Plugins/**/Binaries/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$CLAUDE_PROJECT_DIR/Scripts/claude/guard.sh\"; bash -n \"$G\" 2>/dev/null || { echo \"guard.sh does not parse - guard SKIPPED, fix it\" >&2; exit 1; }; bash \"$G\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$CLAUDE_PROJECT_DIR/Scripts/claude/stop-check.sh\"; bash -n \"$S\" 2>/dev/null || { echo \"stop-check.sh does not parse - check SKIPPED, fix it\" >&2; exit 1; }; bash \"$S\"",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}